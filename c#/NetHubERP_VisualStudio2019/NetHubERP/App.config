<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Ajuste Data Source para o nome mostrado na janela Conectar do SSMS.
         Windows Authentication recomendado para laboratório local. -->
    <add name="NetHubERP"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=NetHubERP;Integrated Security=True;Connect Timeout=8;Encrypt=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
